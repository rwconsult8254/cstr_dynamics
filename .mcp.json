{
  "mcpServers": {
    "process-engineering-rag": {
      "command": "uv",
      "args": [
        "run",
        "/home/roger/dev/process-engineering/rag/mcp_serve.py"
      ],
      "env": {
        "QDRANT_HOST": "localhost",
        "QDRANT_PORT": "6333",
        "OLLAMA_URL": "http://localhost:11434",
        "EMBED_MODEL": "nomic-embed-text",
        "COLLECTION": "process-engineering"
      }
    },
    "garden-rag": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/home/roger/rag",
        "python",
        "/home/roger/rag/scripts/serve.py"
      ],
      "env": {
        "QDRANT_HOST": "localhost",
        "QDRANT_PORT": "6333",
        "QDRANT_COLLECTION": "garden",
        "EMBEDDING_MODEL": "BAAI/bge-large-en-v1.5",
        "EMBEDDING_DEVICE": "cuda"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  }
}
